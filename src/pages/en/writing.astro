---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { t } from '../../i18n';
import { publications } from '../../data/publications';

const lang = 'en' as const;
const tt = t[lang];
const list = publications[lang];
---

<BaseLayout title={`${tt.writingTitle} — Yuto Mitomi`} lang={lang}>
  <div class="markdown-body">
    <h1>{tt.writingTitle}</h1>
    <p>
      {tt.writingIntro}{' '}
      <a href="https://zenn.dev/techliberty">Zenn</a> and{' '}
      <a href="https://buildersbox.corp-sansan.com/">Sansan Builders Box</a>.
    </p>
    {
      list.map((p, i) => (
        <>
          {i > 0 && <hr />}
          <div data-reveal>
            <PublicationCard pub={p} />
          </div>
        </>
      ))
    }
  </div>
</BaseLayout>
