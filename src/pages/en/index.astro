---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TerminalHero from '../../components/TerminalHero.astro';
import Bio from '../../components/Bio.astro';
import TechSkills from '../../components/TechSkills.astro';
import ExperienceCard from '../../components/ExperienceCard.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { t, navHref } from '../../i18n';
import { publications } from '../../data/publications';
import { projects } from '../../data/projects';

const lang = 'en' as const;
const tt = t[lang];

const experiences = (await getCollection('experience'))
  .filter((e) => e.slug.startsWith('en/'))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout lang={lang}>
  <TerminalHero lang={lang} />

  <div class="markdown-body">
    <Bio lang={lang} />

    <section id="education" data-reveal>
      <h2>{tt.education}</h2>
      {
        tt.universities.map((u) => (
          <p>
            {u.name} — {u.degree} (<em>{u.period}</em>)
          </p>
        ))
      }
    </section>

    <section id="work" data-reveal>
      <h2>{tt.work}</h2>
      {
        experiences.map((e, i) => (
          <>
            {i > 0 && <hr />}
            <ExperienceCard
              company={e.data.company}
              role={e.data.role}
              period={e.data.period}
              summary={e.data.summary}
              tags={e.data.tags}
              links={e.data.links}
            />
          </>
        ))
      }
    </section>

    <section id="skills" data-reveal>
      <h2>{tt.skills}</h2>
      <TechSkills lang={lang} />
    </section>

    <section id="publications" data-reveal>
      <h2>{tt.publications}</h2>
      <p>
        <a href={navHref(lang, 'writing')}>{tt.all}</a>
      </p>
      {
        publications[lang].slice(0, 3).map((p, i) => (
          <>
            {i > 0 && <hr />}
            <PublicationCard pub={p} />
          </>
        ))
      }
    </section>

    <section id="projects" data-reveal>
      <h2>{tt.projects}</h2>
      {
        projects[lang].map((p, i) => (
          <>
            {i > 0 && <hr />}
            <ProjectCard project={p} />
          </>
        ))
      }
    </section>
  </div>
</BaseLayout>
