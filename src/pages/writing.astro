---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { t } from '../i18n';
import { publications } from '../data/publications';

const lang = 'ja' as const;
const tt = t[lang];
const list = publications[lang];
---

<BaseLayout title={`${tt.writingTitle} — 三富 佑人`} lang={lang}>
  <div class="markdown-body">
    <h1>{tt.writingTitle}</h1>
    <p>
      主に
      <a href="https://zenn.dev/techliberty">Zenn</a>
      と
      <a href="https://buildersbox.corp-sansan.com/">Sansan Builders Box</a>
      に投稿した技術記事・論文解説。
    </p>
    {
      list.map((p, i) => (
        <>
          {i > 0 && <hr />}
          <div data-reveal>
            <PublicationCard pub={p} />
          </div>
        </>
      ))
    }
  </div>
</BaseLayout>
