---
interface Props {
  company: string;
  role: string;
  period: string;
  summary: string;
  tags: string[];
  links?: { label: string; url: string }[];
}
const { company, role, period, summary, tags, links = [] } = Astro.props;
---

<div>
  <h3>
    {company} <em>— {role}</em>
  </h3>
  <p><strong>{period}</strong></p>
  <p>{summary}</p>
  {
    tags.length > 0 && (
      <p>
        {tags.map((t, i) => (
          <>
            {i > 0 && ' '}
            <code>{t}</code>
          </>
        ))}
      </p>
    )
  }
  {
    links.length > 0 && (
      <p>
        {links.map((l, i) => (
          <>
            {i > 0 && ' · '}
            <a href={l.url} target="_blank" rel="noopener noreferrer">
              {l.label} ↗
            </a>
          </>
        ))}
      </p>
    )
  }
</div>
