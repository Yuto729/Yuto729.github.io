---
interface Props {
  company: string;
  role: string;
  period: string;
  summary: string;
  tags: string[];
  links?: { label: string; url: string }[];
}
const { company, role, period, summary, tags, links = [] } = Astro.props;
---

<div class="border border-border rounded-md p-5">
  <div class="flex items-baseline justify-between gap-4 mb-1">
    <h3 class="text-lg font-semibold text-fg">{company}</h3>
    <span class="font-mono text-xs text-muted whitespace-nowrap">{period}</span>
  </div>
  <div class="text-sm text-muted mb-3">{role}</div>
  <p class="text-fg/85 text-sm leading-relaxed mb-4">{summary}</p>
  {
    tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <span class="font-mono text-[10px] text-muted border border-border rounded px-2 py-0.5">
            {t}
          </span>
        ))}
      </div>
    )
  }
  {
    links.length > 0 && (
      <div class="flex flex-wrap gap-x-4 gap-y-1 mt-4 text-xs">
        {links.map((l) => (
          <a
            href={l.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent underline underline-offset-2 hover:opacity-80"
          >
            {l.label} ↗
          </a>
        ))}
      </div>
    )
  }
</div>
