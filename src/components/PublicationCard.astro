---
import type { Publication } from '../data/publications';

interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
---

<div>
  <h3>
    <a href={pub.url} target="_blank" rel="noopener noreferrer">
      {pub.title} ↗
    </a>
  </h3>
  <p>
    <strong>[{pub.source}]</strong> {pub.date}
  </p>
  {pub.summary && <p>{pub.summary}</p>}
  {
    pub.tags.length > 0 && (
      <p>
        {pub.tags.map((tag, i) => (
          <>
            {i > 0 && ' '}
            <code>{tag}</code>
          </>
        ))}
      </p>
    )
  }
</div>
