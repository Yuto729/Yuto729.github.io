---
// トップページの左サイドバーに置くセクション目次（JS なし）
const items = [
  { id: 'education', label: 'Education' },
  { id: 'work', label: 'Work Experience' },
  { id: 'skills', label: 'Tech Skills' },
  { id: 'publications', label: 'Publications' },
  { id: 'projects', label: 'Personal Projects' },
];
---

<nav aria-label="Sections" class="font-mono">
  <p class="mb-4 text-sm text-muted">$ ls ~/</p>
  <ul class="space-y-1 border-l border-border">
    {items.map((item) => (
      <li>
        <a
          href={`#${item.id}`}
          class="block -ml-px border-l-2 border-transparent py-2 pl-5 text-lg text-muted hover:border-accent hover:text-fg transition-colors"
        >
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
