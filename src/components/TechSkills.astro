---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const labels = t[lang].skillLabels;

const groups: { key: keyof typeof labels; ids: string[] }[] = [
{ key: 'Languages', ids: ['python', 'typescript', 'c', 'bash'] },
  { key: 'Frameworks', ids: ['django', 'react', 'nextjs', 'nodejs'] },
  { key: 'Cloud', ids: ['aws', 'gcp', 'azure'] },
  { key: 'Tools', ids: ['postgres', 'redis', 'docker', 'terraform', 'git', 'githubactions'] },
];
---

<ul>
  {
    groups.map((g) => (
      <li>
        <strong>{labels[g.key]}:</strong>
        <br />
        <img
          src={`https://skillicons.dev/icons?i=${g.ids.join(',')}&theme=dark`}
          alt={`${labels[g.key]} icons`}
          loading="lazy"
        />
      </li>
    ))
  }
  <li>
    <strong>{labels.Spoken}:</strong> {t[lang].spokenValue}
  </li>
</ul>
