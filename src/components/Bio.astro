---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const paragraphs = t[lang].bio;
---

<section class="mt-10 border-l-2 border-accent/60 pl-5 space-y-4" data-reveal>
  {
    paragraphs.map((p) => (
      <p class="text-fg text-base leading-relaxed">{p}</p>
    ))
  }
</section>
