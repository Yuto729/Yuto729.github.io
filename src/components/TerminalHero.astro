---
import { t, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const h = t[lang].hero;
const bio = t[lang].bio;

const contacts = [
  {
    label: 'email',
    value: 'yuto.mitomi0213@gmail.com',
    href: 'mailto:yuto.mitomi0213@gmail.com',
  },
  {
    label: 'github',
    value: 'github.com/Yuto729',
    href: 'https://github.com/Yuto729',
  },
  {
    label: 'linkedin',
    value: 'linkedin.com/in/yuto-mitomi-5a92652b0',
    href: 'https://www.linkedin.com/in/yuto-mitomi-5a92652b0',
  },
  {
    label: 'zenn',
    value: 'zenn.dev/techliberty',
    href: 'https://zenn.dev/techliberty',
  },
  {
    label: 'resume',
    value: 'Google Drive',
    href: 'https://drive.google.com/file/d/1CLe6qvLuT17xtVMWkgq-Rw-C004OXRfY/view',
  },
];

const sections = ['education', 'work', 'skills', 'publications', 'projects', 'writing'];
const hint = lang === 'ja' ? "'help' と入力してコマンド一覧を表示" : "type 'help' to see available commands";
---

<section class="font-mono text-sm md:text-base leading-relaxed" data-reveal>
  <div id="terminal-body" class="border border-border rounded-sm bg-black/40 overflow-hidden cursor-text">
    <div class="flex gap-1.5 px-4 py-2 border-b border-border">
      <span class="w-3 h-3 rounded-full bg-red-400/60"></span>
      <span class="w-3 h-3 rounded-full bg-yellow-400/60"></span>
      <span class="w-3 h-3 rounded-full bg-green-400/60"></span>
      <span class="ml-2 text-xs text-muted">~ — zsh</span>
    </div>
    <div class="px-5 py-5 space-y-1">
      <div id="terminal-output" class="space-y-1">
        <div>
          <span class="text-accent">$</span> <span class="text-fg">{h.cmds[0]}</span>
        </div>
        <div class="text-fg/85 pl-4">{h.title}</div>

        <div>
          <span class="text-accent">$</span> <span class="text-fg">{h.cmds[1]}</span>
        </div>
        <div class="pl-4">
          {
            contacts.map((c) => (
              <div class="flex gap-3">
                <span class="text-muted shrink-0 w-20">{c.label}</span>
                <a
                  href={c.href}
                  target={c.href.startsWith('mailto:') ? undefined : '_blank'}
                  rel={c.href.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
                  class="text-fg hover:text-accent underline underline-offset-2 truncate"
                >
                  {c.value}{c.href.startsWith('http') ? ' ↗' : ''}
                </a>
              </div>
            ))
          }
        </div>

        <div class="text-muted text-xs pt-2">{hint}</div>
      </div>

      <form id="terminal-form" autocomplete="off" class="flex items-center gap-2">
        <span class="text-accent shrink-0">$</span>
        <input
          id="terminal-input"
          type="text"
          spellcheck="false"
          autocapitalize="off"
          autocorrect="off"
          aria-label="terminal input"
          class="flex-1 bg-transparent text-fg outline-none border-none font-mono caret-accent"
        />
      </form>
      <noscript>
        <div><span class="text-accent">$</span> <span class="cursor"></span></div>
      </noscript>
    </div>
  </div>
</section>

<script define:vars={{ contacts, bio, heroTitle: h.title, sections, lang }}>
  const output = document.getElementById('terminal-output');
  const input = document.getElementById('terminal-input');
  const form = document.getElementById('terminal-form');
  const terminal = document.getElementById('terminal-body');
  if (output && input && form && terminal) {
    const initialHTML = output.innerHTML;
    const history = [];
    let historyIndex = 0;

    const escapeHtml = (s) =>
      String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    const print = (text, cls = 'pl-4 text-fg/85') => {
      const lines = String(text).split('\n');
      for (const line of lines) {
        const div = document.createElement('div');
        div.className = cls + ' whitespace-pre-wrap break-words';
        div.textContent = line;
        output.appendChild(div);
      }
    };

    const printPrompt = (cmd) => {
      const div = document.createElement('div');
      div.innerHTML = `<span class="text-accent">$</span> <span class="text-fg">${escapeHtml(cmd)}</span>`;
      output.appendChild(div);
    };

    const commands = {
      help() {
        return [
          'available commands:',
          '  help              show this message',
          '  ls                list page sections',
          '  pwd               print current path',
          '  cd <section>      jump to a section (e.g. cd writing, cd skills)',
          '  open <name>       open a contact link (github, linkedin, zenn, email, resume)',
          '  whoami            print name',
          '  cat about.txt     print bio',
          '  lang <ja|en>      switch language',
          '  echo <text>       print text',
          '  date              print current date',
          '  clear             clear the terminal',
          '',
          'tip: press Tab to autocomplete commands and arguments.',
        ].join('\n');
      },
      pwd() {
        return lang === 'ja' ? '~/ja' : '~';
      },
      ls() {
        return sections.join('  ');
      },
      cd(args) {
        const target = (args[0] || '').replace(/^\/+|\/+$/g, '');
        if (!target || target === '~') {
          location.href = lang === 'ja' ? '/ja/' : '/';
          return null;
        }
        if (target === 'writing') {
          location.href = lang === 'ja' ? '/ja/writing/' : '/writing/';
          return null;
        }
        if (sections.includes(target)) {
          const el = document.getElementById(target);
          if (el) {
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return null;
          }
        }
        return `cd: no such section: ${target}`;
      },
      open(args) {
        const name = args[0];
        if (!name) return `usage: open <${contacts.map((c) => c.label).join('|')}>`;
        const c = contacts.find((c) => c.label === name);
        if (!c) return `open: not found: ${name}\navailable: ${contacts.map((c) => c.label).join(', ')}`;
        const isMail = c.href.startsWith('mailto:');
        window.open(c.href, isMail ? '_self' : '_blank', isMail ? '' : 'noopener,noreferrer');
        return `opening ${c.label}...`;
      },
      whoami() {
        return heroTitle;
      },
      cat(args) {
        const file = args[0];
        if (file === 'about.txt') return bio.join('\n\n');
        if (!file) return 'usage: cat <file>';
        return `cat: ${file}: No such file or directory`;
      },
      lang(args) {
        const target = args[0];
        if (target === 'ja') { location.href = '/ja/'; return null; }
        if (target === 'en') { location.href = '/'; return null; }
        return 'usage: lang <ja|en>';
      },
      echo(args) {
        return args.join(' ');
      },
      date() {
        return new Date().toString();
      },
      clear() {
        output.innerHTML = initialHTML;
        return null;
      },
    };

    const allCommands = Object.keys(commands);
    const completionsFor = {
      cd: [...sections, '~'],
      open: contacts.map((c) => c.label),
      cat: ['about.txt'],
      lang: ['ja', 'en'],
    };

    const longestCommonPrefix = (strs) => {
      if (strs.length === 0) return '';
      let prefix = strs[0];
      for (let i = 1; i < strs.length; i++) {
        while (!strs[i].startsWith(prefix)) {
          prefix = prefix.slice(0, -1);
          if (!prefix) return '';
        }
      }
      return prefix;
    };

    const completeInput = () => {
      const value = input.value;
      const cursorPos = input.selectionStart ?? value.length;
      const before = value.slice(0, cursorPos);
      const after = value.slice(cursorPos);

      // Find the start of the current token (last whitespace-separated word before cursor)
      const m = before.match(/(\S*)$/);
      const token = m ? m[1] : '';
      const tokenStart = cursorPos - token.length;

      // What are we completing? Command (no leading non-space content), or arg (cmd has been typed)?
      const head = before.slice(0, tokenStart).trim();
      const candidates = head === '' ? allCommands : completionsFor[head.split(/\s+/)[0]];
      if (!candidates) return;

      const matches = candidates.filter((c) => c.startsWith(token));
      if (matches.length === 0) return;

      const isCommandCompletion = head === '';

      if (matches.length === 1) {
        const completion = matches[0] + (isCommandCompletion ? ' ' : '');
        input.value = before.slice(0, tokenStart) + completion + after;
        const newPos = tokenStart + completion.length;
        input.setSelectionRange(newPos, newPos);
        return;
      }

      const common = longestCommonPrefix(matches);
      if (common.length > token.length) {
        input.value = before.slice(0, tokenStart) + common + after;
        const newPos = tokenStart + common.length;
        input.setSelectionRange(newPos, newPos);
        return;
      }

      // Multiple matches with no further common prefix: list them as a hint
      printPrompt(value);
      print(matches.join('  '));
    };

    const run = (raw) => {
      const line = raw.trim();
      if (!line) return;
      history.push(line);
      historyIndex = history.length;
      printPrompt(line);
      const parts = line.split(/\s+/);
      const cmd = parts[0];
      const args = parts.slice(1);
      const fn = Object.hasOwn(commands, cmd) ? commands[cmd] : null;
      const result = fn ? fn(args) : `${cmd}: command not found. type 'help' for available commands.`;
      if (result != null) print(result);
      requestAnimationFrame(() => input.scrollIntoView({ block: 'nearest' }));
    };

    let isComposing = false;
    input.addEventListener('compositionstart', () => { isComposing = true; });
    input.addEventListener('compositionend', () => { isComposing = false; });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      // Skip if user is mid-IME-composition (e.g. converting Japanese kanji)
      if (isComposing) return;
      run(input.value);
      input.value = '';
    });

    input.addEventListener('keydown', (e) => {
      if (isComposing) return;
      if (e.key === 'Tab') {
        e.preventDefault();
        completeInput();
        return;
      }
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (historyIndex > 0) {
          historyIndex--;
          input.value = history[historyIndex];
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIndex < history.length - 1) {
          historyIndex++;
          input.value = history[historyIndex];
        } else {
          historyIndex = history.length;
          input.value = '';
        }
      } else if (e.key === 'l' && e.ctrlKey) {
        e.preventDefault();
        output.innerHTML = initialHTML;
      }
    });

    terminal.addEventListener('click', (e) => {
      const target = e.target;
      if (target instanceof HTMLAnchorElement) return;
      if (window.getSelection && String(window.getSelection()).length > 0) return;
      input.focus();
    });
  }
</script>
