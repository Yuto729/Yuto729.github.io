---
import type { Lang } from '../i18n';
import { altLangPath, t } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const target = altLangPath(Astro.url.pathname, lang);
const label = t[lang].langSwitchTo;
---

<a
  href={target}
  class="font-mono text-xs text-muted hover:text-fg transition-colors border border-border rounded px-2 py-1"
  aria-label={`Switch to ${label}`}
>
  {label}
</a>
