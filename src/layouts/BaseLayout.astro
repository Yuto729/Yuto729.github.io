---
import '../styles/global.css';
import LangSwitch from '../components/LangSwitch.astro';
import { t, navHref, type Lang } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const { title, description, lang = 'en' } = Astro.props;
const tt = t[lang];
const defaultTitle = lang === 'ja' ? '三富 佑人' : 'Yuto Mitomi';
const defaultDesc =
  lang === 'ja'
  ? '東京在住のソフトウェアエンジニア。バックエンドや分散システム, LLM の活用に関心。'
    : 'Software Engineer based in Tokyo. Backend, distributed systems, and applied LLM.';

const pageTitle = title ?? defaultTitle;
const pageDesc = description ?? defaultDesc;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-bg text-fg font-sans">
    <div class="max-w-3xl mx-auto px-6 py-12 md:py-20">
      <header class="mb-12 flex items-center justify-between gap-4 font-mono text-sm text-muted">
        <a href={navHref(lang, 'overview')} class="hover:text-fg transition-colors">~/</a>
        <div class="flex items-center gap-5">
          <nav class="flex gap-5">
            <a href={navHref(lang, 'overview')} class="hover:text-fg transition-colors">{tt.nav.overview}</a>
            <a href={navHref(lang, 'writing')} class="hover:text-fg transition-colors">{tt.nav.writing}</a>
          </nav>
          <LangSwitch lang={lang} />
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="mt-24 pt-8 border-t border-border font-mono text-xs text-muted">
        <span>© {new Date().getFullYear()} {lang === 'ja' ? '三富 佑人' : 'Yuto Mitomi'}</span>
      </footer>
    </div>

    <style is:global>
      [data-reveal] {
        opacity: 0;
        transform: translateY(12px);
        transition:
          opacity 0.6s ease,
          transform 0.6s ease;
      }
      [data-reveal].reveal-in {
        opacity: 1;
        transform: translateY(0);
      }
      @media (prefers-reduced-motion: reduce) {
        [data-reveal] {
          opacity: 1;
          transform: none;
          transition: none;
        }
      }
    </style>

    <script>
      const targets = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window && targets.length > 0) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-in');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('reveal-in'));
      }
    </script>
  </body>
</html>
