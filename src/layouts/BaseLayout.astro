---
import '../styles/global.css';
import LangSwitch from '../components/LangSwitch.mdx';
import { t, navHref, type Lang } from '../i18n';
import faviconSvg from '../../public/favicon.svg?raw';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const { title, description, lang = 'ja' } = Astro.props;
const tt = t[lang];
const defaultTitle = lang === 'ja' ? '三富 佑人' : 'Yuto Mitomi';
const defaultDesc =
  lang === 'ja'
  ? '東京在住のソフトウェアエンジニア。Webバックエンドや分散システム, LLM の活用に関心'
    : 'Software Engineer based in Tokyo. Web Backend, distributed systems, and applied LLM.';

const pageTitle = title ?? defaultTitle;
const pageDesc = description ?? defaultDesc;
// 広い画面では sidebar スロットを左カラムに置き、本文と2カラムにする
const hasSidebar = Astro.slots.has('sidebar');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDesc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`data:image/svg+xml,${encodeURIComponent(faviconSvg)}`} />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-bg text-fg font-sans">
    <div
      class:list={[
        'max-w-4xl mx-auto px-6 py-12 md:py-20',
        hasSidebar && 'min-[1240px]:max-w-[76rem] min-[1240px]:grid min-[1240px]:grid-cols-[16rem_minmax(0,1fr)] min-[1240px]:gap-12',
      ]}
    >
      {hasSidebar && (
        <aside class="hidden min-[1240px]:block">
          <div class="sticky top-12 pt-[4.75rem]">
            <slot name="sidebar" />
          </div>
        </aside>
      )}
      <div class="min-w-0">
      <header class="mb-12 flex items-center justify-between gap-4 font-mono text-sm text-muted">
        <a href={navHref(lang, 'overview')} class="hover:text-fg transition-colors">~/</a>
        <div class="flex items-center gap-5">
          <nav class="flex gap-5">
            <a href={navHref(lang, 'overview')} class="hover:text-fg transition-colors">{tt.nav.overview}</a>
            <a href={navHref(lang, 'writing')} class="hover:text-fg transition-colors">{tt.nav.writing}</a>
          </nav>
          <LangSwitch lang={lang} pathname={Astro.url.pathname} />
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="mt-24 pt-8 border-t border-border font-mono text-xs text-muted">
        <span>© {new Date().getFullYear()} {lang === 'ja' ? '三富 佑人' : 'Yuto Mitomi'}</span>
      </footer>
      </div>
    </div>

    <script type="speculationrules" set:html={JSON.stringify({
      prerender: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
    })} />
  </body>
</html>
